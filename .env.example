# Required in production. Use a long random value (32+ bytes recommended).
AUTH_SECRET=replace-with-a-long-random-secret

# Optional. Defaults to ./data. Point this at a mounted persistent volume in production.
DATA_DIR=./data

# Optional. Keep true/omit on HTTPS production. Set false only for local HTTP production runs (e.g. Docker on localhost).
COOKIE_SECURE=true
